rules_version = '2';

// Image uploads (menu + gallery) are only allowed from authenticated staff,
// in the menu/ and gallery/ folders, and must be image files under 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /menu/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidImage();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidImage();
    }
  }
}