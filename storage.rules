rules_version = '2';

// Any file is readable by everyone. Uploads are performed ONLY server-side by
// the Firebase Admin SDK (Vercel /api/admin/upload), which bypasses these
// rules, so direct client uploads are denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}