rules_version = '2';

// Public site (menu, gallery, testimonials, business info) is readable by everyone.
// Writes are restricted to authenticated users (staff) — admin panel only.
// Note: use your own ownership/role model to further restrict writes if needed
// (e.g. compare a claims or a `users` collection role == 'owner').
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    match /menuItems/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /galleryImages/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /businessInfo/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}