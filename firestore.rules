rules_version = '2';

// Public site (menu, gallery, testimonials, business info) is readable by everyone.
// All writes are performed ONLY server-side by the Firebase Admin SDK
// (Vercel /api/admin/* functions), which bypasses these rules entirely, so
// direct client writes are denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}