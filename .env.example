# Firebase configuration (keep secrets out of public repos — Vite inlines VITE_* at build time).
# 1. Create a project at https://console.firebase.google.com
# 2. Add a web app, copy its config here (values from Firebase console → Project settings → General).
# 3. Enable Firestore (Database) and Storage in the console.
# 4. Publish the rules shipped in /firestore.rules and /storage.rules (Rules tab, or firebase deploy).
# 5. Generate a service account key: Project settings → Service accounts → Generate new private key.
# 6. Set all variables below in Vercel → Project → Settings → Environment Variables, then redeploy.
#
# The public site only READS Firestore/Storage directly (rules allow read for everyone).
# Every admin WRITE goes through Vercel /api/admin/* functions using the Firebase Admin SDK,
# which checks the x-admin-password header against ADMIN_PASSWORD (no Firebase Authentication,
# no user accounts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared admin password for /admin (server-side only, never exposed to the client).
ADMIN_PASSWORD=

# Full contents of the service-account JSON (the whole JSON, not a file path, not base64).
FIREBASE_SERVICE_ACCOUNT_KEY=
