# Firebase configuration (keep secrets out of public repos — Vite inlines these at build time).
# 1. Create a project at https://console.firebase.google.com
# 2. Add a web app, copy its config here (values from Firebase console → Project settings → General).
# 3. Enable Firestore (Database) and Authentication → Email/Password in the console.
# 4. Enable Storage and apply the rules shipped in /firestore.rules and /storage.rules.
# 5. Create staff accounts under Authentication → Users → Add user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=